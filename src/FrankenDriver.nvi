<?xml version="1.0" encoding="utf-8"?>
<nvi name="FrankenDriverCert" title="${{title}}" version="${{version}}" versionText="${{version}}" timestamp="2022-07-07T12:06:13" disposition="default" hidden="true" no-arp="true" installerMin="2.1002.158.1207" bare="false" diskSpaceForBare="8" continueOnFailure="true">
	<filter name="32bit" platform="x86"/>
	<filter name="64bit" platform="amd64"/>
	<constraints>
	</constraints>
	<dependencies>
	</dependencies>
	<properties>
	</properties>
	<manifest>
		<file name="FrankenDriver.nvi" sizeKB="20"/><file name="FrankenDriver.cer"/></manifest>
	<phases>
		<exe phase="InstallFrankenDriverCertRoot" onError="ignore" name="${{SystemDirectory}}\certutil.exe" when="install" progress="120" condition="!RepairMode" autoTick="200">
			<arg value="-addstore"/>
			<arg value="-f"/>
			<arg value="Root"/>
			<arg value="${{SubPackageDirectory}}\FrankenDriver.cer"/>
			<success value="0"/>
		</exe>
		<exe phase="InstallFrankenDriverCertCA" onError="ignore" name="${{SystemDirectory}}\certutil.exe" when="install" progress="120" condition="!RepairMode" autoTick="200">
			<arg value="-addstore"/>
			<arg value="-f"/>
			<arg value="CA"/>
			<arg value="${{SubPackageDirectory}}\FrankenDriver.cer"/>
			<success value="0"/>
		</exe>
		<exe phase="InstallFrankenDriverCertRoot_repair" onError="ignore" name="${{SystemDirectory}}\certutil.exe" when="install" progress="120" condition="RepairMode" autoTick="200">
			<arg value="-addstore"/>
			<arg value="-f"/>
			<arg value="Root"/>
			<arg value="${{SubPackageDirectory}}\FrankenDriver.cer"/>
			<success value="0"/>
		</exe>
		<exe phase="InstallFrankenDriverCertCA_repair" onError="ignore" name="${{SystemDirectory}}\certutil.exe" when="install" progress="120" condition="RepairMode" autoTick="200">
			<arg value="-addstore"/>
			<arg value="-f"/>
			<arg value="CA"/>
			<arg value="${{SubPackageDirectory}}\FrankenDriver.cer"/>
			<success value="0"/>
		</exe>
		<exe phase="InstallFrankenDriverCertTrustedPublisher" onError="ignore" name="${{SystemDirectory}}\certutil.exe" when="install" progress="120" condition="!RepairMode" autoTick="200">
			<arg value="-addstore"/>
			<arg value="-f"/>
			<arg value="TrustedPublisher"/>
			<arg value="${{SubPackageDirectory}}\FrankenDriver.cer"/>
			<success value="0"/>
		</exe>
		<exe phase="InstallFrankenDriverCertTrustedPublisher_repair" onError="ignore" name="${{SystemDirectory}}\certutil.exe" when="install" progress="120" condition="RepairMode" autoTick="200">
			<arg value="-addstore"/>
			<arg value="-f"/>
			<arg value="TrustedPublisher"/>
			<arg value="${{SubPackageDirectory}}\FrankenDriver.cer"/>
			<success value="0"/>
		</exe>
	</phases>
	<strings>
		<string name="title" value="FrankenDriver certificate Installation"/>
		<string name="version" value="2022"/>
		<string name="packageType" value="full"/>
		<string name="InstallText" value="${{InstallOnlyText}}"/>
	</strings>
	<strings>
		<localized locale="0x0409">
			<string name="InstallSafeModeBlockedMessage" value="${{title}} cannot be installed in safe mode."/>
			<string name="ErrorInstallerAlreadyRunning" value="Other installations are running. Finish the other installations then try again."/>
			<string name="InstallNotNeeded" value="Installation of ${{title}} not needed."/>
			<string name="MSVCRuntimeNotInstalled" value="${{title}} ${{version}} not present. Install the ${{title}} and try again."/>
			<string name="InstallOnlyText" value="Installing ${{title}}; This will take some time."/>
		</localized>
		<localized locale="0x0419">
			<string name="InstallSafeModeBlockedMessage" value="Установить ${{title}} в безопасном режиме невозможно."/>
			<string name="ErrorInstallerAlreadyRunning" value="Работают другие программы установки. Завершите другие процессы установки и повторите попытку."/>
			<string name="InstallNotNeeded" value="Установка ${{title}} не требуется."/>
			<string name="MSVCRuntimeNotInstalled" value="${{title}} ${{version}} отсутствует. Установите ${{title}} и повторите попытку."/>
